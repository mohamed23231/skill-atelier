  "views": {
    "sequence": {
      "title": "Order Fulfillment Saga with Compensating Rollback Flow",
      "steps": [
        {
          "step": 1,
          "from": "checkout_app",
          "to": "saga_orchestrator",
          "label": "Customer submits Checkout for Order #9901",
          "sync": true
        },
        {
          "step": 2,
          "from": "saga_orchestrator",
          "to": "outbox_table",
          "label": "Atomically commit Order (STATUS=PENDING) and Outbox event in single DB TX",
          "sync": true
        },
        {
          "step": 3,
          "from": "outbox_poller",
          "to": "kafka_broker",
          "label": "Publish OrderCreatedEvent to Kafka topic 'order.events'",
          "sync": false
        },
        {
          "step": 4,
          "from": "kafka_broker",
          "to": "payment_service",
          "label": "Payment Service captures payment from Stripe token ($149.00)",
          "sync": false
        },
        {
          "step": 5,
          "from": "payment_service",
          "to": "kafka_broker",
          "label": "Emit PaymentCapturedEvent to 'payment.events'",
          "sync": false
        },
        {
          "step": 6,
          "from": "kafka_broker",
          "to": "inventory_service",
          "label": "Inventory Service allocates SKU stock (Quantity: 2)",
          "sync": false
        },
        {
          "step": 7,
          "from": "inventory_service",
          "to": "kafka_broker",
          "label": "Emit InventoryReservedEvent to 'inventory.events'",
          "sync": false
        },
        {
          "step": 8,
          "from": "kafka_broker",
          "to": "warehouse_service",
          "label": "Warehouse Service attempts dispatch but encounters damaged physical stock",
          "sync": false
        },
        {
          "step": 9,
          "from": "warehouse_service",
          "to": "kafka_broker",
          "label": "Emit WarehouseDispatchFailedEvent to trigger saga compensation",
          "sync": false
        },
        {
          "step": 10,
          "from": "kafka_broker",
          "to": "saga_orchestrator",
          "label": "Orchestrator receives failure event; executes CompensateOrderSaga()",
          "sync": false
        },
        {
          "step": 11,
          "from": "saga_orchestrator",
          "to": "payment_service",
          "label": "COMPENSATION: Invoke RefundPayment(order_id) to refund $149.00",
          "sync": true
        },
        {
          "step": 12,
          "from": "saga_orchestrator",
          "to": "inventory_service",
          "label": "COMPENSATION: Invoke ReleaseInventory(order_id) to unlock reserved units",
          "sync": true
        },
        {
          "step": 13,
          "from": "warehouse_service",
          "to": "dlq_queue",
          "label": "Route corrupted payload to fulfillment.dlq after 3 retries",
          "sync": false
        },
        {
          "step": 14,
          "from": "dlq_queue",
          "to": "dlq_triage_worker",
          "label": "Trigger PagerDuty High-Severity Alert for on-call triage",
          "sync": false
        }
      ]
    },
