      "nodeId": "inventory_service",
      "type": "table",
      "locator": "inventory_allocations",
      "verification": "compatibility",
      "description": "Inventory SKU allocation tracking table"
    },
    {
      "id": "ev_warehouse_service",
      "nodeId": "warehouse_service",
      "type": "file",
      "locator": "services/warehouse/app/dispatch.py",
      "verification": "compatibility",
      "description": "Warehouse dispatch handler and 3PL courier interface"
    }
  ],
  "policies": [
    {
      "id": "pol_checkout_routes_to_orchestrator",
      "kind": "required_dependency",
      "from": "checkout_app",
      "to": "saga_orchestrator",
      "description": "Checkout app traffic must initiate through the Saga Orchestrator"
    },
    {
      "id": "pol_no_client_to_subsystems",
      "kind": "forbidden_dependency",
      "from": "checkout_app",
      "to": "payment_service",
      "description": "Checkout client must not invoke fulfillment subsystems directly without saga orchestration"
    },
    {
      "id": "pol_no_client_to_outbox",
      "kind": "forbidden_dependency",
      "from": "checkout_app",
      "to": "outbox_table",
      "description": "Client applications must not access internal outbox tables directly"
    },
    {
      "id": "pol_verified_node_evidence",
      "kind": "required_evidence",
      "description": "All verified services and topics in the saga workflow must carry compatibility evidence",
      "status": "VERIFIED"
    }
  ],
  "scenarios": [
    {
      "id": "scenario_fulfillment_saga_dlq",
      "name": "Order Fulfillment Saga with Parallel Execution & DLQ Compensation",
      "description": "Executes parallel payment and inventory fulfillment branches, handling physical warehouse damage via DLQ quarantine and automated compensations.",
      "stages": [
        {
          "id": "stage_submit_checkout",
          "name": "Initiate Checkout",
          "type": "interaction",
          "source": "checkout_app",
          "target": "saga_orchestrator",
          "from": "checkout_app",
          "to": "saga_orchestrator",
          "edgeId": "e_client_saga",
          "label": "HTTPS POST /checkout",
          "payload": {
            "orderId": "9901",
            "amount": 149,
            "sku": "SKU-DESK-01",
            "quantity": 2
          },
          "status": "success"
        },
        {
          "id": "stage_persist_outbox",
          "name": "Atomic Order & Outbox Commit",
          "type": "interaction",
          "source": "saga_orchestrator",
          "target": "outbox_table",
          "from": "saga_orchestrator",
          "to": "outbox_table",
          "edgeId": "e_saga_outbox",
          "label": "Atomic SQL INSERT",
          "payload": {
            "orderId": "9901",
            "eventType": "OrderCreatedEvent",
            "status": "PENDING"
          },
          "status": "success",
          "metadata": {
            "transactional": true
          }
        },
        {
          "id": "stage_relay_outbox_event",
          "name": "Outbox Polling & Kafka Dispatch",
          "type": "interaction",
          "source": "outbox_table",
          "target": "outbox_poller",
          "from": "outbox_table",
          "to": "outbox_poller",
          "edgeId": "e_outbox_poller",
          "label": "Poll Pending Events",
          "payload": {
            "status": "PENDING",
            "limit": 100
          },
          "status": "success"
        },
        {
          "id": "stage_publish_order_created",
          "name": "Publish to Kafka Event Bus",
          "type": "interaction",
          "source": "outbox_poller",
          "target": "kafka_broker",
          "from": "outbox_poller",
          "to": "kafka_broker",
          "edgeId": "e_poller_kafka",
          "label": "Produce OrderCreatedEvent",
          "payload": {
            "topic": "order.events",
            "orderId": "9901"
          },
          "status": "success"
        },
        {
          "id": "stage_parallel_fulfillment_branches",
          "name": "Parallel Fulfillment Branches (Payment & Inventory)",
          "type": "parallel",
          "description": "Concurrent execution of payment authorization and stock reservation",
          "stages": [
            {
              "id": "stage_payment_branch",
              "name": "Payment Authorization Branch",
              "type": "interaction",
              "source": "kafka_broker",
              "target": "payment_service",
              "from": "kafka_broker",
              "to": "payment_service",
              "edgeId": "e_kafka_payment",
              "label": "Consume OrderCreated",
              "payload": {
                "orderId": "9901",
                "amount": 149
              },
              "status": "success"
            },
            {
              "id": "stage_payment_emitted",
              "name": "Emit Payment Authorized",
              "type": "interaction",
              "source": "payment_service",
              "target": "kafka_broker",
              "from": "payment_service",
              "to": "kafka_broker",
              "edgeId": "e_payment_kafka",
              "label": "Produce PaymentAuthorized",
              "payload": {
                "orderId": "9901",
                "chargeId": "ch_3Mv9x"
              },
              "status": "success"
            },
            {
              "id": "stage_inventory_branch",
              "name": "Inventory Reservation Branch",
              "type": "interaction",
              "source": "kafka_broker",
              "target": "inventory_service",
              "from": "kafka_broker",
              "to": "inventory_service",
              "edgeId": "e_kafka_inventory",
              "label": "Consume PaymentAuthorized",
              "payload": {
                "orderId": "9901",
                "sku": "SKU-DESK-01",
                "quantity": 2
              },
              "status": "success"
            },
            {
              "id": "stage_inventory_emitted",
              "name": "Emit Inventory Reserved",
              "type": "interaction",
              "source": "inventory_service",
              "target": "kafka_broker",
              "from": "inventory_service",
              "to": "kafka_broker",
              "edgeId": "e_inventory_kafka",
              "label": "Produce InventoryReserved",
              "payload": {
                "orderId": "9901",
                "reservationId": "res_88291"
              },
              "status": "success"
            }
          ]
        },
        {
          "id": "stage_warehouse_dispatch_attempt",
          "name": "Warehouse Dispatch Attempt",
          "type": "interaction",
          "source": "kafka_broker",
          "target": "warehouse_service",
          "from": "kafka_broker",
          "to": "warehouse_service",
          "edgeId": "e_kafka_warehouse",
          "label": "Consume InventoryReserved",
          "payload": {
            "orderId": "9901",
            "warehouseId": "WH-DXB-02"
          },
          "status": "success"
        },
        {
          "id": "stage_warehouse_outcome_branch",
          "name": "Warehouse Dispatch & DLQ Failure Recovery",
          "type": "branch",
          "description": "Branching based on physical package condition at retrieval time",
          "condition": "Physical items intact in warehouse bin",
          "branches": [
            {
              "name": "Dispatch Successful",
              "condition": "Items verified and courier label generated",
              "status": "success",
              "stages": []
            },
            {
              "name": "Damaged Item DLQ Quarantine & Compensation",
              "condition": "Physical stock damaged; retry exhausted (3 attempts failed)",
              "status": "recovery",
              "recovery": "Quarantine poison event to DLQ, notify on-call, and execute orchestrator compensations across payment and inventory",
              "stages": [
                {
                  "id": "stage_route_dlq",
                  "name": "Quarantine to DLQ Queue",
                  "type": "interaction",
                  "source": "warehouse_service",
                  "target": "dlq_queue",
                  "from": "warehouse_service",
                  "to": "dlq_queue",
                  "edgeId": "e_warehouse_dlq",
                  "label": "Route 3x Failed Message",
                  "payload": {
                    "orderId": "9901",
                    "retries": 3,
                    "error": "PHYSICAL_DAMAGE_STOCK_EXHAUSTED"
                  },
                  "status": "recovery"
                },
                {
                  "id": "stage_dlq_triage_alert",
                  "name": "Triage Worker PagerDuty Alert",
                  "type": "interaction",
                  "source": "dlq_queue",
                  "target": "dlq_triage_worker",
                  "from": "dlq_queue",
                  "to": "dlq_triage_worker",
                  "edgeId": "e_dlq_triage",
                  "label": "Consume Poison Message",
                  "payload": {
                    "severity": "CRITICAL",
                    "incident": "PD-58291"
                  },
                  "status": "recovery"
                },
                {
                  "id": "stage_orchestrator_failure_notify",
                  "name": "Deliver Failure Event to Orchestrator",
                  "type": "interaction",
                  "source": "kafka_broker",
                  "target": "saga_orchestrator",
                  "from": "kafka_broker",
                  "to": "saga_orchestrator",
                  "edgeId": "e12",
                  "label": "Failure event",
                  "payload": {
                    "orderId": "9901",
                    "eventType": "warehouse.dispatch.failed"
                  },
                  "status": "recovery"
                },
                {
                  "id": "stage_compensation_refund",
                  "name": "Compensating Payment Refund",
                  "type": "interaction",
                  "source": "saga_orchestrator",
                  "target": "payment_service",
                  "from": "saga_orchestrator",
                  "to": "payment_service",
                  "edgeId": "e13",
                  "label": "Compensate: refund",
                  "payload": {
                    "orderId": "9901",
                    "refundAmount": 149
                  },
                  "status": "recovered"
                },
                {
                  "id": "stage_compensation_release_inventory",
                  "name": "Compensating Inventory Release",
                  "type": "interaction",
                  "source": "saga_orchestrator",
                  "target": "inventory_service",
                  "from": "saga_orchestrator",
                  "to": "inventory_service",
                  "edgeId": "e14",
                  "label": "Compensate: release",
                  "payload": {
                    "orderId": "9901",
                    "reservationId": "res_88291"
                  },
                  "status": "recovered"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
