  "scenarios": [
    {
      "id": "scenario_po_discount_valuation",
      "name": "Purchase Order Creation & Discounted Valuation Lifecycle",
      "description": "Serial procurement flow with dynamic volume discount lookup and fallback recovery path.",
      "stages": [
        {
          "id": "stage_po_submission",
          "name": "Submit Purchase Order",
          "type": "interaction",
          "source": "procurement_portal",
          "target": "api_gateway",
          "from": "procurement_portal",
          "to": "api_gateway",
          "edgeId": "e_portal_gateway",
          "label": "POST /api/v1/purchase-orders",
          "payload": {
            "supplierId": "sup-789",
            "items": [
              {
                "sku": "SKU-4401",
                "quantity": 500,
                "unitPrice": 45
              }
            ]
          },
          "status": "success",
          "metadata": {
            "auth": "Bearer JWT",
            "clientVersion": "2.4.0"
          }
        },
        {
          "id": "stage_gateway_forward",
          "name": "Route Validated Request",
          "type": "interaction",
          "source": "api_gateway",
          "target": "purchasing_service",
          "from": "api_gateway",
          "to": "purchasing_service",
          "edgeId": "e_gateway_purchasing",
          "label": "gRPC CreatePO",
          "payload": {
            "poId": "po-9910",
            "supplierId": "sup-789",
            "grossTotal": 22500
          },
          "status": "success",
          "metadata": {
            "mtls": true,
            "traceId": "c4b9-4401"
          }
        },
        {
          "id": "stage_discount_evaluation",
          "name": "Evaluate Supplier Discounts",
          "type": "interaction",
          "source": "purchasing_service",
          "target": "supplier_discount_service",
          "from": "purchasing_service",
          "to": "supplier_discount_service",
          "edgeId": "e_purchasing_discount",
          "label": "gRPC EvaluateDiscounts",
          "payload": {
            "supplierId": "sup-789",
            "volume": 500,
            "bracketYear": 2026
          },
          "status": "success",
          "metadata": {
            "timeoutMs": 1500
          }
        },
        {
          "id": "stage_discount_branching",
          "name": "Discount Evaluation Result & Valuation",
          "type": "branch",
          "description": "Branching based on supplier discount calculation availability",
          "condition": "Supplier discount service responds within timeout",
          "branches": [
            {
              "name": "Volume Rebate Applied",
              "condition": "Active tier found and valid rate returned",
              "status": "success",
              "stages": [
                {
                  "id": "stage_persist_discounted_po",
                  "name": "Persist Discounted PO",
                  "type": "interaction",
                  "source": "purchasing_service",
                  "target": "primary_db",
                  "from": "purchasing_service",
                  "to": "primary_db",
                  "edgeId": "e_purchasing_db",
                  "label": "SQL INSERT purchase_orders",
                  "payload": {
                    "poId": "po-9910",
                    "totalDiscount": 2700,
                    "netTotal": 19800
                  },
                  "status": "success"
                },
                {
                  "id": "stage_read_batches",
                  "name": "Read Batch Costs",
                  "type": "interaction",
                  "source": "inventory_valuation_service",
                  "target": "primary_db",
                  "from": "inventory_valuation_service",
                  "to": "primary_db",
                  "edgeId": "e_valuation_db",
                  "label": "SQL Read Batches",
                  "payload": {
                    "sku": "SKU-4401"
                  },
                  "status": "success"
                },
                {
                  "id": "stage_fetch_schedules",
                  "name": "Fetch Rebate Schedules",
                  "type": "interaction",
                  "source": "inventory_valuation_service",
                  "target": "supplier_discount_service",
                  "from": "inventory_valuation_service",
                  "to": "supplier_discount_service",
                  "edgeId": "e_valuation_discount",
                  "label": "gRPC GetActiveDiscounts",
                  "payload": {
                    "sku": "SKU-4401"
                  },
                  "status": "success"
                },
                {
                  "id": "stage_append_valuation_audit",
                  "name": "Append Valuation Audit Entry",
                  "type": "interaction",
                  "source": "inventory_valuation_service",
                  "target": "audit_store",
                  "from": "inventory_valuation_service",
                  "to": "audit_store",
                  "edgeId": "e_valuation_audit",
                  "label": "SQL Append Audit",
